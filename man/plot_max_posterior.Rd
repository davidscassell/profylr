\name{plot_max_posterior}
\alias{plot_max_posterior}
\title{plot max posterior}
\description{
  plot max posterior for a profylr fit. Release 1 estimates indicators only.
  Covariates are refused. Defaults, tolerances, and the bootstrap
  count are the values documented in the package specification.
}
\usage{
plot_max_posterior(fit)
}
\arguments{
  \item{fit}{A fitted model.}
}
\value{
  A ggplot of the maximum posterior.
}
