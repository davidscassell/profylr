\name{plot_avepp}
\alias{plot_avepp}
\title{plot avepp}
\description{
  plot avepp for a profylr fit. Release 1 estimates indicators only.
  Covariates are refused. Defaults, tolerances, and the bootstrap
  count are the values documented in the package specification.
}
\usage{
plot_avepp(fit)
}
\arguments{
  \item{fit}{A fitted model.}
}
\value{
  A ggplot of average posteriors.
}
