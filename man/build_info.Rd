\name{build_info}
\alias{build_info}
\title{Compiler and Eigen build record}
\description{
  Compiler and Eigen build record for a profylr fit. Release 1 estimates indicators only.
  Covariates are refused. Defaults, tolerances, and the bootstrap
  count are the values documented in the package specification.
}
\usage{
build_info()
}
\arguments{
  None.
}
\value{
  The object documented by the function name. Fitters return a
  \code{profylr_fit}.
}
