\name{plot_fit_criteria}
\alias{plot_fit_criteria}
\title{plot fit criteria}
\description{
  plot fit criteria for a profylr fit. Release 1 estimates indicators only.
  Covariates are refused. Defaults, tolerances, and the bootstrap
  count are the values documented in the package specification.
}
\usage{
plot_fit_criteria(x)
}
\arguments{
  \item{x}{Argument \code{x}.}
}
\value{
  The object documented by the function name. Fitters return a
  \code{profylr_fit}.
}
