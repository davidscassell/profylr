\name{blrt_hardware_threads}
\alias{blrt_hardware_threads}
\title{blrt hardware threads}
\description{
  blrt hardware threads for a profylr fit. Release 1 estimates indicators only.
  Covariates are refused. Defaults, tolerances, and the bootstrap
  count are the values documented in the package specification.
}
\usage{
blrt_hardware_threads()
}
\arguments{
  None.
}
\value{
  The object documented by the function name. Fitters return a
  \code{profylr_fit}.
}
