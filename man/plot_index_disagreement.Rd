\name{plot_index_disagreement}
\alias{plot_index_disagreement}
\title{plot index disagreement}
\description{
  plot index disagreement for a profylr fit. Release 1 estimates indicators only.
  Covariates are refused. Defaults, tolerances, and the bootstrap
  count are the values documented in the package specification.
}
\usage{
plot_index_disagreement(selection)
}
\arguments{
  \item{selection}{A selection result.}
}
\value{
  A ggplot of index disagreement.
}
