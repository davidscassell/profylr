CXX_STD = CXX17
# -ffast-math is not passed. GCC and Clang leave it off unless it is requested,
# and the sources reject a build that defines __FAST_MATH__. R CMD check
# treats -fno-fast-math in PKG_CXXFLAGS as a non-portable flag, so that switch
# is not repeated here. -ffp-contract=off is required: the default gnu++
# dialect contracts multiply-adds, and that changes the likelihood.
# NDEBUG and EIGEN_NO_DEBUG turn Eigen's assert checks off on every build,
# including a build that is not otherwise a release build.
PKG_CXXFLAGS = -I../inst/include -DEIGEN_DONT_PARALLELIZE -DNDEBUG -DEIGEN_NO_DEBUG -ffp-contract=off -pthread
PKG_LIBS = -pthread
